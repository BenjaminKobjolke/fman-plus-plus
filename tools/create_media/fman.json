{
  "process_name": "python.exe",
  "title_substring": "fman",
  "output_dir": "../../media",
  "scale_to_window_size": true,
  "launch": {
    "command": ["cmd", "/c",
      "D:/GIT/BenjaminKobjolke/fman/tools/create_media/run_fman_demo.bat",
      "{demo_id}", "{port}", "{width}", "{height}"],
    "cwd": "D:/GIT/BenjaminKobjolke/fman"
  },
  "demos": [
    {"id": 1, "name": "overview", "fps": 10, "formats": ["gif", "mp4"],
     "width": 1920, "height": 1080},
    {"id": 2, "name": "themes", "fps": 2, "formats": [],
     "width": 1920, "height": 1080},

    {"id": 3, "name": "tour-a-panes", "fps": 10, "formats": ["mp4"],
     "width": 1920, "height": 1080, "group": "tour",
     "caption": "Two panes, one keyboard  \u00b7  select, copy, filter, sort"},
    {"id": 4, "name": "tour-b-organize", "fps": 10, "formats": ["mp4"],
     "width": 1920, "height": 1080, "group": "tour",
     "caption": "Organize without leaving the keyboard  \u00b7  F7 new folder, F6 move, Shift+F6 rename"},
    {"id": 5, "name": "tour-c-viewers", "fps": 10, "formats": ["mp4"],
     "width": 1920, "height": 1080, "group": "tour",
     "caption": "Preview inside the pane  \u00b7  images and text, zoom, edit, save"},
    {"id": 6, "name": "tour-d-video", "fps": 10, "formats": ["mp4"],
     "width": 1920, "height": 1080, "group": "tour",
     "caption": "Video plays in the pane  \u00b7  and previews in the other one"},
    {"id": 7, "name": "tour-e-archives", "fps": 10, "formats": ["mp4"],
     "width": 1920, "height": 1080, "group": "tour",
     "caption": "Archives are just folders  \u00b7  pack, step inside, copy out"},

    {"id": 8, "name": "feature-goto", "fps": 5, "formats": ["mp4"],
     "width": 1920, "height": 1080, "group": "feature"},
    {"id": 9, "name": "feature-tail", "fps": 5, "formats": ["mp4"],
     "width": 1920, "height": 1080, "group": "feature"},

    {"id": 10, "name": "plugin-matrix-rain", "fps": 5, "formats": ["mp4"],
     "width": 1920, "height": 1080, "group": "plugin"},
    {"id": 11, "name": "dialogs", "fps": 2, "formats": [],
     "width": 1920, "height": 1080},
    {"id": 12, "name": "links", "fps": 2, "formats": [],
     "width": 1920, "height": 1080},
    {"id": 13, "name": "context-menu", "fps": 2, "formats": [],
     "width": 1920, "height": 1080},
    {"id": 14, "name": "command-palette", "fps": 2, "formats": [],
     "width": 1920, "height": 1080},
    {"id": 15, "name": "listing", "fps": 2, "formats": [],
     "width": 1920, "height": 1080},
    {"id": 16, "name": "fman-account", "fps": 2, "formats": [],
     "width": 1920, "height": 1080},
    {"id": 17, "name": "ftp-overwrite", "fps": 2, "formats": [],
     "width": 1920, "height": 1080},
    {"id": 18, "name": "single-instance", "fps": 2, "formats": [],
     "width": 1920, "height": 1080},
    {"id": 19, "name": "transfer-failure", "fps": 2, "formats": [],
     "width": 1920, "height": 1080}
  ],
  "compose": [
    {"type": "tour", "group": "tour", "output": "demos/tour/feature-tour.mp4",
     "width": 1280, "fps": 30, "caption_seconds": 5},

    {"type": "stills_gif", "demo": "themes", "output": "demos/themes/themes.gif",
     "hold": 2.0, "width": 960},

    {"type": "mp4_gif", "group": "feature", "output": "demos/features/{short}.gif",
     "fps": 5, "width": 800, "colors": 64},

    {"type": "mp4_gif", "group": "plugin", "output": "demos/plugins/{short}.gif",
     "fps": 4, "width": 360, "colors": 32, "lossy": 60}
  ]
}
