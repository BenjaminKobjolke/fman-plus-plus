QTableView, QMessageBox, QDialog, QListView {
	background-color: $pane_bg;
	border: none;
}

QHeaderView, QHeaderView::section {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 $header_bg, stop: 1 $pane_bg);
}

QHeaderView::section {
	color: $muted_fg;
	border: none;
	padding: 1ex;
	border-style: solid;
	border-left-width: 1px;
	border-left-color: $pane_bg;
	border-right-color: $header_bg;
	border-right-width: 1px;
}

QTableView::item {
	color: $pane_fg;
	padding-top: 1px;
	padding-bottom: 1px;
}

/*
 * Hack: Unlike QTreeView::item, QTableView::item has no :first and :last
 * selectors. To work around this, our backend sets State_Children and
 * State_Open, which we can catch here as :has-children and :open, respectively.
 */
QTableView::item:has-children {
	color: $pane_fg_dir;
	padding-left: 0.25em;
	/* The padding directive has no effect unless we specify a background: */
	background: transparent;
}
QTableView::item:open {
	padding-right: 0.25em;
}

/* :disabled is set by the delegate for hidden rows; repeat the selected
 * selector so selection color wins over the hidden-row color. */
QTableView::item:disabled {
	color: $pane_hidden_fg;
}
QTableView::item:has-children:disabled {
	color: $pane_hidden_fg_dir;
}

QTableView::item:selected, QTableView::item:selected:disabled {
	color: $pane_selected_fg;
	/* Avoid the ugly default blue background color for selected cells: */
	background-color: $pane_bg;
}

QTableView::item:focus {
	background-color: $pane_cursor_bg;
}

/*
 * A theme may place background images (see docs/THEMES.md). Where one is
 * drawn, the surface above it must stop painting its own background or
 * nothing of the image would show. The fman_background property is set
 * from Python - impl/view/backgrounds.py, set_transparent() - because
 * which surfaces are covered depends on what the theme asked for.
 *
 * The cursor row above keeps its fill: it is the one thing that has to
 * stay readable over any artwork. Selected rows give theirs up, since
 * $pane_selected_fg already tells them apart and an opaque block would
 * punch a hole through the image.
 */
QTableView[fman_background="true"],
QTableView[fman_background="true"]::item:selected,
QHeaderView[fman_background="true"],
QHeaderView[fman_background="true"]::section,
QStatusBar[fman_background="true"],
PaneStatusLine[fman_background="true"],
LocationBar[fman_background="true"] {
	background: transparent;
}

QTableView #editor {
	/*
	 * The Qt "editor" when renaming a file. It's a QLineEdit, which has a
	 * border (see below). On Windows, this border shifts the file name down so
	 * much that underscores "_" are obscured. Prevent this:
	 */
	border-top: none;
	border-bottom: none;
}

QLabel, QRadioButton, QCheckBox {
	color: $muted_fg;
}

QMessageBox QLabel {
	font-weight: normal;
	/*
	 * QMessageBox sizes itself from its label. Without the padding, short texts
	 * (eg. the About dialog) produce a cramped box whose text nearly touches
	 * the border.
	 *
	 * Do NOT add a min-width here. It does not act as a floor: it pins the box
	 * to that width for every message, so anything longer is silently cut off
	 * ("Matrix screensaver is off." showed as "Matrix screensaver is o"). The
	 * padding is what keeps short messages from looking cramped, and unlike
	 * min-width it is part of QLabel::sizeHint(), which is what QMessageBox
	 * measures - so the box still grows with the text. MessageBox in widgets.py
	 * establishes the width floor with a layout spacer instead.
	 *
	 * Alignment is NOT set here either. It used to be `qproperty-alignment:
	 * AlignCenter`, but a stylesheet qproperty is re-applied on every polish and
	 * so silently overrode the left-alignment that multi-line messages need.
	 * MessageBox._apply_layout_fixes() now owns it: centered for a one-line
	 * message (matching the centered buttons), left-aligned for a paragraph.
	 */
	padding: .5em .75em;
}

QLineEdit {
	color: $bright_fg;
	background-color: $input_bg;
	border: 1px solid $input_border;
	border-left-color: $pane_bg;
	border-top-color: $pane_bg;
}

Prompt QLineEdit {
	min-width: 20em;
}

Quicksearch {
	background-color: $popup_bg;
}

Quicksearch #query-container {
	/*
	 * The sole purpose of this Div is to draw an extra border at the bottom.
	 */
	padding: 0;
	margin: 3px;
	border: 1px solid $popup_bg;
	border-bottom-color: $popup_query_border;
}

Quicksearch #query-container > Div {
	padding: 0;
	border: 1px solid $popup_query_inner_border;
}

Quicksearch QLineEdit {
	color: $popup_input_fg;
	background-color: $popup_input_bg;
	border: 1px solid $popup_input_border;
	border-top-color: $popup_input_border_top;
	border-left-color: $popup_input_border_left;
	border-right-color: $popup_input_border_right;
}

Quicksearch #items-container {
	margin-bottom: 4px;
}

Quicksearch QListView {
	min-width: 40em;
	background-color: $popup_bg;
	margin-left: 4px;
	margin-right: 4px;
}

Quicksearch QListView::item:selected {
	background-color: $popup_selected_bg;
}

QLineEdit:read-only {
	color: $readonly_fg;
}

/*
 * Dims the main window while a modal dialog is open. The alpha byte in
 * $scrim_bg is the strength of the dim.
 */
Scrim {
	background-color: $scrim_bg;
}

QStatusBar {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 $statusbar_bg_top, stop: 1 $statusbar_bg_bottom);
	border-top: 1px solid $border;
}

QStatusBar, QStatusBar QLabel {
	color: $bright_fg;
}

QStatusBar QLabel {
	padding-left: .1ex;
}

PaneStatusLine {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 $statusbar_bg_top, stop: 1 $statusbar_bg_bottom);
	border-top: 1px solid $border;
	color: $bright_fg;
	padding-left: .1ex;
}

SplashScreen QPushButton {
	max-width: 4em;
}

Overlay {
	min-width: 20em;
	max-width: 22em;
	background-color: $pane_bg;
	border: 1px solid $border;
}

Overlay QPushButton {
	max-width: 10em;
}

FilterBar {
	background-color: $pane_bg;
	border: 1px solid $border;
	min-width: 8em;
}

FilterBar QLineEdit {
	font-size: 9pt;
	width: 7em;
	margin: 0 .25em;
}

NonexistentShortcutDialog {
	min-width: 15em;
}

NonexistentShortcutDialog QRadioButton {
	margin-left: 1em;
}

NonexistentShortcutDialog QLineEdit {
	margin-left: 2.25em;
	margin-right: 1em;
}

QRadioButton::checked {
	color: $bright_fg;
}

/* A dialog without a title bar, because the main window hides its own. */
*[frameless="true"] {
	border: 1px solid $border;
}

ProgressDialog {
	min-width: 25em;
	/*
	 * Make max-width at least a little wider than min-width.
	 * Otherwise, there sometimes seem to be visual artifacts.
	 */
	max-width: 30em;
}
