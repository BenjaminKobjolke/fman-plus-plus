{
	"app_name": "fman",
	"display_name": "fman++",
	"version": "1.9.1",
	"author": "Benjamin Kobjolke",
	"author_email": "",
	"description": "A modern file manager for power users. Beautiful, fast and extensible",
	"url": "https://workflow-tools.com/fman-plus-plus/help/",
	"main_module": "src/main/python/fman/main.py",
	"freeze_dir": "target/${app_name}",
	"test_dirs": [
		"src/main/resources/base/Plugins/Core"
	],
	"release": false,
	"environment": "local",
	"files_to_filter": [
		"src/build/docker/arch/Dockerfile",
		"src/build/docker/ubuntu/Dockerfile",
		"src/build/docker/fedora/Dockerfile",
		"src/build/docker/fedora/.rpmmacros"
	],
	"public_settings": [
		"environment"
	],
	"gpg_key": "45BCC825BC281C06D2A7F912B015FE599CFAF7EB",
	"gpg_name": "Michael Herrmann",
	"gpg_pass": "fenst4r",
	"core_plugin_in_freeze_dir": "${freeze_dir}/Plugins/Core",
	"docker_images": {
		"arch": {
			"build_files": [
				"src/sign/linux/",
				"conf/ssh/",
				"requirements/"
			]
		},
		"ubuntu": {
			"build_files": [
				"src/sign/linux/",
				"conf/ssh/",
				"requirements/"
			]
		},
		"fedora": {
			"build_files": [
				"src/sign/linux/",
				"requirements/"
			]
		}
	},
	"hidden_imports": [
		"requests",
		"mpv",
		"PyQt5.QtSvg",
		"pygments",
		"xml.dom",
		"xml.dom.minidom",
		"psutil",
		"fman.impl.update_countdown"
	],
	"extra_pyinstaller_args": [
		"--additional-hooks-dir",
		"${project_dir}/src/build/pyinstaller_hooks",
		"--exclude-module",
		"boto3",
		"--exclude-module",
		"botocore",
		"--exclude-module",
		"s3transfer",
		"--exclude-module",
		"automated_screenshot_connector"
	]
}
